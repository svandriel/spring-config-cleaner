{
  "name": "spring-config-cleaner",
  "version": "0.0.0",
  "description": "Cleans spring configuration yaml files",
  "keywords": [
    "spring",
    "config",
    "cleaner"
  ],
  "homepage": "https://github.com/svandriel/spring-config-cleaner#readme",
  "bugs": {
    "url": "https://github.com/svandriel/spring-config-cleaner/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svandriel/spring-config-cleaner.git"
  },
  "license": "MIT",
  "author": "Sander van Driel <sander.vandriel@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1 <25",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc -b tsconfig.app.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc -b",
    "lint": "biome check . && markdownlint-cli2 && node scripts/lint-yaml.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm clean && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.ts": [
      "biome check --write"
    ],
    "*.json": [
      "biome check --write"
    ],
    "*.md": [
      "markdownlint-cli2"
    ],
    "*.{yaml,yml}": [
      "node scripts/lint-yaml.mjs"
    ]
  }
}
